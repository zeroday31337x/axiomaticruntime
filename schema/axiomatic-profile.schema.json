{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axiomatic Runtime Profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "origin",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "origin": {
      "enum": [
        "zdx-validated",
        "customer-modified"
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "allowedCommands",
        "allowedTools",
        "mutatingTools",
        "nonMutatingCommands"
      ],
      "properties": {
        "allowedCommands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\./[a-z0-9._/-]+$"
          },
          "uniqueItems": true,
          "maxItems": 256
        },
        "allowedTools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "uniqueItems": true,
          "maxItems": 256
        },
        "mutatingTools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "uniqueItems": true,
          "maxItems": 256
        },
        "nonMutatingCommands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\./[a-z0-9._/-]+$"
          },
          "uniqueItems": true,
          "maxItems": 256
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
